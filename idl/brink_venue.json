  "types": [
    {
      "name": "Benchmark",
      "docs": [
        "Benchmark account. The swap AMM reads this layout directly (owner-checked), so field order is frozen per",
        "`version`; both programs upgrade together when it changes.",
        "",
        "Space is declared by hand (`impl Space`) because the fixings ring is held in a `Box`: the account is about",
        "2.7 KB and a by-value deserialisation of it needs two copies in one SBF stack frame, above the 4 KB frame",
        "limit (the toolchain reports the overflow at build time). With the ring on the heap the struct is about 700",
        "bytes on the stack and the ring is copied once, in its own frame. The wire layout is unchanged: a boxed array",
        "serialises as the array."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "version",
            "type": "u8"
          },
          {
            "name": "registry",
            "type": "pubkey"
          },
          {
            "name": "id",
            "type": {
              "array": [
                "u8",
                16
              ]
            }
          },
          {
            "name": "source",
            "type": "pubkey"
          },
          {
            "name": "value_bp",
            "type": "u16"
          },
          {
            "name": "ema_bp",
            "type": "u16"
          },
          {
            "name": "slot",
            "type": "u64"
          },
          {
            "name": "unix_ts",
            "type": "i64"
          },
          {
            "name": "accrual_e18",
            "type": "u128"
          },
          {
            "name": "max_staleness_slots",
            "type": "u64"
          },
          {
            "name": "band_bp",
            "type": "u16"
          },
          {
            "name": "half_life_slots",
            "type": "u64"
          },
          {
            "name": "min_interval_slots",
            "type": "u64"
          },
          {
            "name": "published",
            "type": "bool"
          },
          {
            "name": "publish_count",
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "prev_value_bp",
            "docs": [
              "Value held over the most recent accrual segment `[prev_unix_ts, unix_ts]` (maths finding M-2)."
            ],
            "type": "u16"
          },
          {
            "name": "prev_unix_ts",
            "docs": [
              "Start of the most recent accrual segment; equals `unix_ts` until the second accepted value."
            ],
            "type": "i64"
          },
          {
            "name": "max_drift_bp",
            "docs": [
              "Drift bound (S-6): the value may move at most this far from `drift_anchor_bp` within one window."
            ],
            "type": "u16"
          },
          {
            "name": "drift_window_slots",
            "type": "u64"
          },
          {
            "name": "drift_anchor_bp",
            "type": "u16"
          },
          {
            "name": "drift_anchor_slot",
            "type": "u64"
          },
          {
            "name": "clamped",
            "docs": [
              "The last accepted value was clamped by the band or the drift bound."
            ],
            "type": "bool"
          },
          {
            "name": "disputed",
            "docs": [
              "The last aggregation had a quorum of fresh observations that did not agree; the value was not moved."
            ],
            "type": "bool"
          },
          {
            "name": "support",
            "docs": [
              "Observations that supported the last accepted value. `1` means a single-publisher (devnet) registry."
            ],
            "type": "u8"
          },
          {
            "name": "observations",
            "type": {
              "array": [
                {
                  "defined": {
                    "name": "Observation"
                  }
                },
                5
              ]
            }
          },
          {
            "name": "ema_milli_bp",
            "docs": [
              "EMA at bp x 1 000 (maths finding M-6). `ema_bp` is `rhu(ema_milli_bp / 1 000)`; at most",
              "`MAX_RATE_BP x 1 000`, so it fits `u32` and the `u16` narrowing of `ema_bp` cannot fail."
            ],
            "type": "u32"
          },
          {
            "name": "fixing_first_day",
            "docs": [
              "UTC day number (unix seconds / 86 400) of the oldest fixing ever written; 0 until the first midnight the",
              "benchmark lives through."
            ],
            "type": "u32"
          },
          {
            "name": "fixing_head_day",
            "docs": [
              "UTC day number of the most recent fixing written."
            ],
            "type": "u32"
          },
          {
            "name": "fixings",
            "docs": [
              "Ring of `FIXING_DAYS` daily fixings: the cumulative accrual (`accrual_e18` units) at 00:00 UTC of day `d`",
              "lives at byte offset `16 * (d % FIXING_DAYS)` as a little-endian `u128`. Written by `publish` for every",
              "midnight a segment crosses; read by the AMM to settle a swap at its maturity whatever was published later",
              "(ADR-006, review finding F-12, maths finding M-2, simulation finding S-3). Raw bytes rather than",
              "`[u128; N]` so that loading the account is a copy, not a per-element decode; boxed so that copy is made",
              "once, outside the account's own stack frame."
            ],
            "type": {
              "array": [
                "u8",
                2048
              ]
            }
          },
          {
            "name": "ema_slot",
            "docs": [
              "Slot at which the EMA last moved (or was confirmed equal to its input); the decay of the next step is",
              "measured from here, not from the last publication (M-11)."
            ],
            "type": "u64"
          },
          {
            "name": "accepted_slot",
            "docs": [
              "Slot of the transaction that last accepted a value. `slot` is the freshness of the data behind it (M-12);",
              "this is when the benchmark itself last moved, used to widen the band after an outage."
            ],
            "type": "u64"
          },
          {
            "name": "support_lost",
            "docs": [
              "The observations behind the last accepted value no longer amount to a quorum of currently registered,",
              "fresh publishers: set by `remove_publisher` and `set_publishers` for the benchmarks passed to them, by",
              "`revalidate`, and by `publish` when fewer registered observations than the quorum are fresh. Degrades the",
              "benchmark until the next accepted value clears it (external scan 2, finding 8)."
            ],
            "type": "bool"
          },
          {
            "name": "_reserved",
            "type": {
              "array": [
                "u8",
                11
              ]
            }
          }
        ]
      }
    },
